MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab20dd5b0d1341848ad08d21d2348ee9, type: 3}
  m_Name: Blanche
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  playOnlyOnce: 1
  voiceSoundName: DialogueVoice
  mainDialogue:
  - speakerName: Rose
    portrait: {fileID: 0}
    dialogueText: "Blanche... \xE9... \xE9 voc\xEA mesmo?"
    voicePitchMin: 0.9
    voicePitchMax: 1.2
  - speakerName: Blanche
    portrait: {fileID: 0}
    dialogueText: "... Rose... Rose! Minha irm\xE3 querida, achei que tivesse te
      perdido."
    voicePitchMin: 1
    voicePitchMax: 1.3
  - speakerName: Blanche
    portrait: {fileID: 0}
    dialogueText: "Mas... como? O Rei dos Duendes... onde ele est\xE1? O que ele
      fez com voc\xEA?"
    voicePitchMin: 1
    voicePitchMax: 1.3
  - speakerName: Rose
    portrait: {fileID: 0}
    dialogueText: "Ele se foi. Ele n\xE3o poder\xE1 fazer mal nenhum a mais ningu\xE9m."
    voicePitchMin: 0.9
    voicePitchMax: 1.2
  - speakerName: Rose
    portrait: {fileID: 0}
    dialogueText: "Ah, Blanche! Estou t\xE3o feliz em v\xEA-la de novo, minha queria
      e amada irm\xE3."
    voicePitchMin: 0.9
    voicePitchMax: 1.2
  - speakerName: Blanche
    portrait: {fileID: 0}
    dialogueText: "N\xE3o consigo nem imaginar tudo o que voc\xEA deve ter passado...
      mas agora n\xE3o importa. Nada nem ningu\xE9m poder\xE1 nos separar agora."
    voicePitchMin: 1
    voicePitchMax: 1.3
  summaryDialogue: []
  moverNpcAposDialogo: 0
  posicaoDestinoNpc: {x: 1000, y: 1000}
  criarItemAposDialogo: 0
  prefabItemColetavel: {fileID: 0}
  deslocamentoItem: {x: 0, y: 0.5}
