%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ab20dd5b0d1341848ad08d21d2348ee9, type: 3}
  m_Name: Alberich
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  playOnlyOnce: 0
  voiceSoundName: DialogueVoice
  mainDialogue:
  - speakerName: Alberich, o Rei dos Duendes
    portrait: {fileID: 0}
    dialogueText: "... Ent\xE3o, eis a pobre dozela que ousa desafiar-me..."
    voicePitchMin: 0.3
    voicePitchMax: 0.6
  - speakerName: Rose
    portrait: {fileID: 0}
    dialogueText: "D\xEA-me a minha irm\xE3 de volta."
    voicePitchMin: 0.9
    voicePitchMax: 1.2
  - speakerName: Alberich, o Rei dos Duendes
    portrait: {fileID: 0}
    dialogueText: "Rose, preste aten\xE7\xE3o... Eu fui generoso at\xE9 agora...
      mas posso ser cruel..."
    voicePitchMin: 0.3
    voicePitchMax: 0.6
  - speakerName: Rose
    portrait: {fileID: 0}
    dialogueText: '"Generoso"? O que fez de "generoso"?'
    voicePitchMin: 0.9
    voicePitchMax: 1.2
  - speakerName: Alberich, o Rei dos Duendes
    portrait: {fileID: 0}
    dialogueText: "Eu fiz tudo! Dei a ti e ao teu amado pr\xEDncipe o privil\xE9gio
      da vida... do esquecimento. "
    voicePitchMin: 0.3
    voicePitchMax: 0.6
  - speakerName: Alberich, o Rei dos Duendes
    portrait: {fileID: 0}
    dialogueText: "... Tentaste resistir e mandei-te meus melhores soldados... Mostrou
      aud\xE1cia e atrevimento em enfrentar a minha Guardi\xE3 Sombria... mandei
      Gudrun dar cabo de ti... Eu virei a Floresta Negra de cabe\xE7a para baixo
      e tudo para deter voc\xEA..."
    voicePitchMin: 0.3
    voicePitchMax: 0.6
  - speakerName: Alberich, o Rei dos Duendes
    portrait: {fileID: 0}
    dialogueText: "... Cansei de dar-lhe oportunidades para dar meia-volta... Isso
      n\xE3o \xE9 ser \"generoso\"?"
    voicePitchMin: 0.3
    voicePitchMax: 0.6
  - speakerName: Rose
    portrait: {fileID: 0}
    dialogueText: "Passei pelos maiores perigos e desafios para chegar, enfim, aos
      dom\xEDnios do Rei dos Duendes... e retomar a irm\xE3 que voc\xEA tirou de
      mim."
    voicePitchMin: 0.9
    voicePitchMax: 1.2
  - speakerName: Rose
    portrait: {fileID: 0}
    dialogueText: "Mesmo que eu pere\xE7a, mesmo que eu leve a eternidade para derrot\xE1-lo...
      Voc\xEA n\xE3o tem nem ter\xE1 poder algum sobre mim!"
    voicePitchMin: 0.9
    voicePitchMax: 1.2
  - speakerName: Alberich, o Rei dos Duendes
    portrait: {fileID: 0}
    dialogueText: "... Ent\xE3o, ser\xE1 mais que um prazer para mim derrot\xE1-la...
      Talvez assim possas gozar da companhia de tua querida irm\xE3..."
    voicePitchMin: 0.3
    voicePitchMax: 0.6
  - speakerName: Alberich, o Rei dos Duendes
    portrait: {fileID: 0}
    dialogueText: "... Venha, luta, implora por tua vida... Mostra-me que \xE9s digna
      da minha MISERIC\xD3RDIA....."
    voicePitchMin: 0.3
    voicePitchMax: 0.6
  summaryDialogue: []
  moverNpcAposDialogo: 0
  posicaoDestinoNpc: {x: 0, y: 0}
  criarItemAposDialogo: 0
  prefabItemColetavel: {fileID: 0}
  deslocamentoItem: {x: 0, y: 0.5}
